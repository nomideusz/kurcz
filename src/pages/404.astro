---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import { extractLocale, localizeHref, routing, t } from '../i18n/config.ts';

const { locale } = extractLocale(Astro.url.pathname, routing);

const route = {
  path: '/404',
  type: 'static',
  h1: t(locale, '404.title'),
  breadcrumbLabel: '404',
  title: `${t(locale, '404.title')} (404) | Kurcz.pl`,
  description: t(locale, '404.p'),
};
---

<Layout route={route} robots="noindex, follow" includeCanonical={false}>
  <Shell currentPath="/404">
    <section class="bg-spot">
      <div class="mx-auto max-w-[1240px] px-4 pb-20 pt-16 sm:px-8 sm:pt-24">
        <p class="font-head text-[clamp(5rem,16vw,9rem)] font-bold leading-none tracking-[-0.03em] text-ink" aria-hidden="true">404</p>
        <h1 class="mt-4 max-w-[40rem] text-[clamp(2rem,5vw,3.25rem)] leading-[1]">{t(locale, '404.title')}</h1>
        <p class="mt-5 max-w-[36rem] text-[1.1875rem] leading-relaxed text-ink">{t(locale, '404.p')}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={localizeHref('/', locale, routing)} class="btn-ink">{t(locale, '404.home_btn')}</a>
          <a href={localizeHref('/poradniki', locale, routing)} class="btn-rule">{t(locale, '404.guides_btn')}</a>
        </div>
      </div>
    </section>
  </Shell>
</Layout>

