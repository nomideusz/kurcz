---
import Layout from '../../layouts/Layout.astro';
import Shell from '../../components/Shell.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getRouteByPath } from '../../seo/routes.js';
import { faqItems } from '../../seo/faq-data.js';
import { LOCALES, DEFAULT_LOCALE, t, localizeHref, routing, type SupportedLocale } from '../../i18n/config.ts';
import { getLocalizedRoute, getLocalizedReliefSteps, getLocalizedTopics, getLocalizedDoctorSigns } from '../../i18n/content.ts';

export function getStaticPaths() {
  const secondaryLocales = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentPath = `/${lang}`;
const rawRoute = getRouteByPath('/');
const route = getLocalizedRoute(rawRoute, lang);

const reliefSteps = getLocalizedReliefSteps(lang);
const topics = getLocalizedTopics(lang);
const doctorSigns = getLocalizedDoctorSigns(lang);
const homeFaq = faqItems.slice(0, 4);
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <!-- HERO -->
    <section class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:py-[72px]">
      <div>
        <div class="eyebrow mb-5 flex items-center gap-2.5 text-faint">
          <span class="h-px w-[22px] bg-[#c9b79b]"></span>{t(lang, 'hero.eyebrow')}
        </div>
        <h1 class="text-5xl leading-[1.02] text-ink sm:text-6xl lg:text-[70px] lg:leading-[1.02]">
          {t(lang, 'hero.h1')}
        </h1>
        <p class="mt-6 max-w-[480px] text-lg leading-relaxed text-body">
          {t(lang, 'hero.p')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href={localizeHref('/pierwsza-pomoc', lang, routing)}
            class="inline-flex items-center gap-2 rounded-md bg-accent px-[26px] py-[15px] text-[15px] font-medium text-paper transition-colors hover:bg-accent-light"
          >
            {t(lang, 'hero.first_aid_btn')} <span class="text-[17px]">→</span>
          </a>
          <a
            href={localizeHref('/kurcze-miesniowe', lang, routing)}
            class="rounded-md border border-[#cfc6b5] px-[22px] py-[15px] text-[15px] font-medium text-ink transition-colors hover:border-ink"
          >
            {t(lang, 'hero.causes_btn')}
          </a>
        </div>
      </div>

      <!-- Quick relief card -->
      <div class="rounded-[10px] border border-line bg-card p-[30px] shadow-[0_1px_2px_rgba(24,36,56,.04),0_12px_30px_rgba(24,36,56,.06)]">
        <div class="mb-5 flex items-center justify-between">
          <span class="eyebrow text-accent">{t(lang, 'relief.title')}</span>
          <span class="font-mono text-[11.5px] text-faint">{t(lang, 'relief.steps_label')}</span>
        </div>
        <div class="flex flex-col">
          {
            reliefSteps.map((s) => (
              <div class="flex gap-4 border-t border-line-soft py-4">
                <span class="w-[26px] flex-none font-serif text-2xl leading-none text-accent">{s.n}</span>
                <div>
                  <div class="mb-1 text-[15px] font-semibold text-ink">{s.title}</div>
                  <div class="text-[13.5px] leading-relaxed text-muted">{s.body}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TOPICS -->
    <section class="mx-auto max-w-7xl px-5 pb-[72px] sm:px-14">
      <div class="mb-7 flex items-end justify-between">
        <h2 class="text-3xl text-ink sm:text-[34px]">{t(lang, 'topics.title')}</h2>
        <span class="font-mono text-xs text-faint">{t(lang, 'topics.count_label', { count: topics.length })}</span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          topics.map((tItem) => (
            <a
              href={localizeHref(tItem.path, lang, routing)}
              class="group flex min-h-[172px] flex-col rounded-[9px] border border-line bg-card p-6 transition-[border-color,transform] hover:-translate-y-0.5 hover:border-accent-border"
            >
              <span class="font-mono text-xs text-faint">{tItem.n}</span>
              <h3 class="mt-3.5 mb-2 text-2xl leading-snug text-ink">{tItem.title}</h3>
              <p class="mb-auto text-sm leading-relaxed text-muted">{tItem.desc}</p>
              <span class="mt-3.5 text-sm text-accent">{t(lang, 'topics.read_more')}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- WHEN TO SEE A DOCTOR -->
    <section class="mx-auto max-w-7xl px-5 pb-[72px] sm:px-14">
      <div class="grid items-center gap-12 rounded-xl bg-navy px-8 py-12 sm:px-13 md:grid-cols-2">
        <div>
          <div class="eyebrow mb-4 text-accent-light">{t(lang, 'doctor.eyebrow')}</div>
          <h2 class="mb-3 text-3xl leading-tight text-[#f4efe6] sm:text-4xl">
            {t(lang, 'doctor.title')}
          </h2>
          <p class="text-[15.5px] leading-relaxed text-[#a9b0bd]">
            {t(lang, 'doctor.p')}
          </p>
        </div>
        <ul class="flex flex-col">
          {
            doctorSigns.map((s) => (
              <li class="flex gap-3.5 border-t border-[#2c3a52] py-3.5 text-[15px] text-[#d9dce2]">
                <span class="font-semibold text-accent">·</span>
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-7xl px-5 pb-[76px] sm:px-14">
      <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <h2 class="mb-3 text-3xl text-ink sm:text-[34px]">{t(lang, 'faq.title')}</h2>
          <p class="text-[15px] leading-relaxed text-muted">
            {t(lang, 'faq.intro')}
          </p>
          <a href={localizeHref('/faq', lang, routing)} class="mt-5 inline-block text-sm text-accent hover:text-accent-light">
            {t(lang, 'faq.see_all')}
          </a>
        </div>
        <FaqAccordion items={homeFaq} bare />
      </div>
    </section>
  </Shell>
</Layout>
