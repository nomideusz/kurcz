---
import ContactPage from '../../components/ContactPage.astro';
import { LOCALES, DEFAULT_LOCALE, type SupportedLocale } from '../../i18n/config.ts';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
---

<ContactPage lang={lang} currentPath={`/${lang}/contact`} />
