---
import Layout from '../../layouts/Layout.astro';
import Shell from '../../components/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { getRouteByPath } from '../../seo/routes.js';
import { LOCALES, DEFAULT_LOCALE, t, localizeHref, routing, type SupportedLocale } from '../../i18n/config.ts';
import { getLocalizedRoute } from '../../i18n/content.ts';

export function getStaticPaths() {
  const secondaryLocales = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentPath = `/${lang}/contact`;
const rawRoute = getRouteByPath('/kontakt');
const route = getLocalizedRoute(rawRoute, lang);
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <Breadcrumbs route={route} currentPath={currentPath} />
    <PageHeader
      title={route.h1}
      intro={t(lang, 'contact.intro')}
      eyebrow={lang === 'en' ? 'get in touch' : 'napisz do nas'}
    />
    <div class="mx-auto max-w-7xl px-5 py-12 sm:px-14">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <div class="rounded-2xl border border-line bg-card p-6 sm:p-8">
            <h2 class="text-2xl text-ink">{lang === 'en' ? 'Before reaching out' : 'Przed wysłaniem wiadomości'}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">
              {lang === 'en' ? 'Looking for immediate cramp relief instructions or answers to common muscle questions? Check our quick sections first:' : 'Jeśli szukasz natychmiastowej instrukcji ulgi przy nagłym ataku skurczu lub odpowiedzi na powszechne pytania, sprawdź nasze sekcje:'}
            </p>
            <div class="mt-6 flex flex-col gap-3">
              <a
                href={localizeHref('/pierwsza-pomoc', lang, routing)}
                class="flex items-center justify-between rounded-xl border border-accent-border bg-accent-bg/60 p-4 text-sm font-semibold text-accent transition-all hover:bg-accent hover:text-paper"
              >
                <span class="inline-flex items-center gap-2">
                  <Icon name="first-aid" class="h-4.5 w-4.5 flex-none" />
                  <span>{t(lang, 'nav.first_aid')} — {lang === 'en' ? 'Immediate Relief' : 'natychmiastowa ulga'}</span>
                </span>
                <span aria-hidden="true">→</span>
              </a>
              <a
                href={localizeHref('/faq', lang, routing)}
                class="flex items-center justify-between rounded-xl border border-line bg-paper p-4 text-sm font-medium text-ink transition-all hover:border-accent hover:text-accent"
              >
                <span class="inline-flex items-center gap-2">
                  <Icon name="faq" class="h-4.5 w-4.5 flex-none text-accent" />
                  <span>{t(lang, 'faq.title')}</span>
                </span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mt-8 flex items-start gap-2.5 border-t border-line-soft pt-6 text-xs leading-relaxed text-faint">
              <Icon name="medical" class="h-4 w-4 flex-none text-accent mt-0.5" />
              <span>{t(lang, 'disclaimer.text')}</span>
            </div>
          </div>
        </div>

        <div>
          <ContactForm currentPath={currentPath} lang={lang} />
        </div>
      </div>
    </div>
  </Shell>
</Layout>


