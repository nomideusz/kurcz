---
import Layout from '../../layouts/Layout.astro';
import Shell from '../../components/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getRouteByPath } from '../../seo/routes.js';
import { LOCALES, DEFAULT_LOCALE, t, type SupportedLocale } from '../../i18n/config.ts';
import { getLocalizedRoute } from '../../i18n/content.ts';

export function getStaticPaths() {
  const secondaryLocales = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentPath = `/${lang}/contact`;
const rawRoute = getRouteByPath('/kontakt');
const route = getLocalizedRoute(rawRoute, lang);
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <Breadcrumbs route={route} currentPath={currentPath} />
    <PageHeader
      title={route.h1}
      intro={t(lang, 'contact.intro')}
    />
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6">
      <ContactForm />
    </div>
  </Shell>
</Layout>
