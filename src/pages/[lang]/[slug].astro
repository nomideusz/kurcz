---
import Layout from '../../layouts/Layout.astro';
import Shell from '../../components/Shell.astro';
import ContentSections from '../../components/ContentSections.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Toc from '../../components/Toc.astro';
import GeometrizedPhoto from '../../components/GeometrizedPhoto.svelte';
import Icon from '../../components/Icon.astro';

import { topicRoutes, staticRoutes } from '../../seo/routes.js';
import { landingRoutes, getLandingPage } from '../../content/landing-pages.js';
import { getStaticPage } from '../../content/static-pages.js';
import { getTopicPageContent } from '../../content/topic-pages.js';
import { getTopicFaq } from '../../seo/topic-faq.js';
import { getPagePhoto } from '../../content/page-photos.ts';
import { LOCALES, DEFAULT_LOCALE, t, localizeHref, routing, toLocalePath, type SupportedLocale } from '../../i18n/config.ts';
import { getLocalizedRoute } from '../../i18n/content.ts';

export function getStaticPaths() {
  const secondaryLocales = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  const topicContentRoutes = topicRoutes.filter(
    (r) => !['/', '/faq', '/kontakt'].includes(r.path)
  );

  const entries = [
    ...topicContentRoutes.map((route) => ({ route, kind: 'topic' })),
    ...landingRoutes.map((route) => ({ route, kind: 'landing' })),
    ...staticRoutes.map((route) => ({ route, kind: 'static' })),
  ];

  return secondaryLocales.flatMap((lang) =>
    entries.map(({ route, kind }) => {
      const localePath = toLocalePath(route.path, lang);
      return {
        params: { lang, slug: localePath.slice(1) },
        props: { route, kind, lang },
      };
    })
  );
}

const { route: rawRoute, kind, lang } = Astro.props as { route: any; kind: string; lang: SupportedLocale };
const route = getLocalizedRoute(rawRoute, lang);
const currentPath = `/${lang}${route.path}`;

let intro = '';
let sections: any[] = [];
let faq: any[] = [];
let relatedLinks: any[] = [];

if (kind === 'topic') {
  const content = getTopicPageContent(route.path, lang);
  intro = content?.intro ?? '';
  sections = content?.sections ?? [];
  faq = getTopicFaq(route.path, lang) ?? [];
  relatedLinks = content?.relatedLinks ?? [];
} else if (kind === 'landing') {
  const page = getLandingPage(route.path, lang);
  if (page) {
    route.h1 = page.h1;
    route.title = page.title;
    route.description = page.description;
    route.breadcrumbLabel = page.h1.split(' — ')[0] ?? page.h1;
    route.hubLabel = t(lang, 'nav.guides');
    intro = page.intro ?? '';
    sections = page.sections ?? [];
    faq = page.faq ?? [];
    relatedLinks = page.relatedLinks ?? [];
  }
} else if (kind === 'static') {
  const page = getStaticPage(route.path, lang);
  if (page) {
    route.h1 = page.h1;
    route.title = page.title;
    route.description = page.description;
    route.breadcrumbLabel = page.breadcrumbLabel ?? route.breadcrumbLabel;
    sections = page.sections ?? [];
  }
}

const pagePhoto = getPagePhoto(route.path);

// Localize links in related links
const localizedRelatedLinks = relatedLinks.map((link) => ({
  ...link,
  path: localizeHref(link.path, lang, routing),
}));

// Crumbs
const crumbs = [{ path: localizeHref('/', lang, routing), label: t(lang, 'nav.home') }];
if (route.hubPath && route.hubLabel) {
  crumbs.push({ path: localizeHref(route.hubPath, lang, routing), label: route.hubLabel.toLowerCase() });
}

// Reading-time estimate
const wordCount = (
  intro +
  ' ' +
  sections.map((s: any) => `${s.heading ?? ''} ${s.body ?? ''} ${(s.bullets ?? []).join(' ')}`).join(' ')
)
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const readMin = Math.max(2, Math.round(wordCount / 200));

const hasToc = sections.filter((s: any) => s.heading).length >= 3;
const eyebrow = (route.breadcrumbLabel ?? route.h1).toLowerCase();
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <!-- ARTICLE HEADER -->
    <section class="border-b border-line bg-card/40">
      <div class="mx-auto max-w-7xl px-5 py-12 sm:px-14">
        <nav aria-label="Breadcrumb navigation" class="mb-6 font-mono text-[12px] text-faint">
          {
            crumbs.map((c) => (
              <>
                <a href={c.path} class="text-faint transition-colors hover:text-ink">{c.label}</a>
                <span class="mx-2 text-[#c3b7a2]">/</span>
              </>
            ))
          }
          <span class="text-accent font-medium">{eyebrow}</span>
        </nav>

        <div class="max-w-[780px]">
          <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-accent-border bg-accent-bg px-3 py-1 font-mono text-xs uppercase tracking-wider text-accent">
            <span>{eyebrow}</span>
          </div>
          <h1 class="text-4xl leading-[1.05] text-ink sm:text-5xl lg:text-[56px] lg:leading-[1.04]">
            {route.h1}
          </h1>
          {
            intro && (
              <div class="mt-6 rounded-xl border border-line-soft bg-paper/80 p-5 sm:p-6 shadow-xs">
                <p class="text-lg leading-relaxed text-body sm:text-[18.5px]">{intro}</p>
              </div>
            )
          }
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-4 font-mono text-[12px] text-faint">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-line bg-card px-2.5 py-1">
            <Icon name="clock" class="h-3.5 w-3.5 text-accent" />
            <span>{t(lang, 'reading_time', { min: readMin })}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-line bg-card px-2.5 py-1">
            <Icon name="calendar" class="h-3.5 w-3.5 text-accent" />
            <span>{t(lang, 'last_updated', { year: '2026' })}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-accent-border bg-accent-bg/50 px-2.5 py-1 text-accent">
            <Icon name="verified" class="h-3.5 w-3.5 text-accent" />
            <span>{lang === 'en' ? 'medically verified' : 'weryfikacja merytoryczna'}</span>
          </span>
        </div>
      </div>
    </section>

    <!-- BODY: TOC + ARTICLE -->
    <section
      class:list={[
        'mx-auto max-w-7xl gap-12 px-5 py-12 sm:px-14',
        hasToc ? 'lg:grid lg:grid-cols-[240px_1fr]' : '',
      ]}
    >
      {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} />}
      <article class="max-w-[740px]">
        {
          pagePhoto && (
            <figure class="mb-10 overflow-hidden rounded-2xl border border-line bg-card shadow-sm">
              <div class="aspect-[16/9] overflow-hidden bg-navy">
                <GeometrizedPhoto
                  client:visible
                  imageKey={pagePhoto.key as any}
                  src={pagePhoto.src}
                  alt={lang === 'en' ? pagePhoto.altEn : pagePhoto.altPl}
                  class="h-full w-full object-cover"
                />
              </div>
              <figcaption class="border-t border-line px-5 py-3.5 text-xs leading-relaxed text-muted bg-card">
                {lang === 'en' ? pagePhoto.captionEn : pagePhoto.captionPl}
              </figcaption>
            </figure>
          )
        }
        <ContentSections sections={sections} />

        <!-- Medical Disclaimer Box -->
        <div class="mt-14 rounded-2xl border border-line bg-card p-6 shadow-xs">
          <div class="flex items-start gap-3.5">
            <div class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-accent-bg text-accent">
              <Icon name="medical" class="h-5 w-5" />
            </div>
            <div>
              <div class="text-sm font-semibold text-ink">{lang === 'en' ? 'Medical Disclaimer' : 'Zastrzeżenie medyczne'}</div>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                {t(lang, 'disclaimer.text')}
              </p>
            </div>
          </div>
        </div>
      </article>
    </section>

    {
      faq.length > 0 && (
        <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-14 border-t border-line-soft pt-12">
          <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
            <div>
              <span class="eyebrow text-accent">{lang === 'en' ? 'article FAQ' : 'pytania do artykułu'}</span>
              <h2 class="mt-1 text-3xl text-ink sm:text-[34px]">{t(lang, 'faq.title')}</h2>
            </div>
            <FaqAccordion items={faq} bare />
          </div>
        </section>
      )
    }

    <RelatedLinks links={localizedRelatedLinks} lang={lang} currentPath={currentPath} />
  </Shell>
</Layout>

