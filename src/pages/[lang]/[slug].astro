---
import ArticlePage from '../../components/ArticlePage.astro';

import { topicRoutes, staticRoutes } from '../../seo/routes.js';
import { landingRoutes, getLandingPage } from '../../content/landing-pages.js';
import { getStaticPage } from '../../content/static-pages.js';
import { getTopicPageContent } from '../../content/topic-pages.js';
import { getTopicFaq } from '../../seo/topic-faq.js';
import { LOCALES, DEFAULT_LOCALE, t, localizeHref, routing, toLocalePath, type SupportedLocale } from '../../i18n/config.ts';
import { getLocalizedRoute } from '../../i18n/content.ts';

export function getStaticPaths() {
  const secondaryLocales = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
  const topicContentRoutes = topicRoutes.filter(
    (r) => !['/', '/faq', '/kontakt'].includes(r.path)
  );

  const entries = [
    ...topicContentRoutes.map((route) => ({ route, kind: 'topic' })),
    ...landingRoutes.map((route) => ({ route, kind: 'landing' })),
    ...staticRoutes.map((route) => ({ route, kind: 'static' })),
  ];

  return secondaryLocales.flatMap((lang) =>
    entries.map(({ route, kind }) => {
      const localePath = toLocalePath(route.path, lang);
      return {
        params: { lang, slug: localePath.slice(1) },
        props: { route, kind, lang },
      };
    })
  );
}

const { route: rawRoute, kind, lang } = Astro.props as { route: any; kind: string; lang: SupportedLocale };
const route = getLocalizedRoute(rawRoute, lang);
const currentPath = `/${lang}${route.path}`;

let intro = '';
let sections: any[] = [];
let faq: any[] = [];
let relatedLinks: any[] = [];

if (kind === 'topic') {
  const content = getTopicPageContent(route.path, lang);
  intro = content?.intro ?? '';
  sections = content?.sections ?? [];
  faq = getTopicFaq(route.path, lang) ?? [];
  relatedLinks = content?.relatedLinks ?? [];
} else if (kind === 'landing') {
  const page = getLandingPage(route.path, lang);
  if (page) {
    route.h1 = page.h1;
    route.title = page.title;
    route.description = page.description;
    route.breadcrumbLabel = page.h1.split(' — ')[0] ?? page.h1;
    route.hubLabel = t(lang, 'nav.guides');
    intro = page.intro ?? '';
    sections = page.sections ?? [];
    faq = page.faq ?? [];
    relatedLinks = page.relatedLinks ?? [];
  }
} else if (kind === 'static') {
  const page = getStaticPage(route.path, lang);
  if (page) {
    route.h1 = page.h1;
    route.title = page.title;
    route.description = page.description;
    route.breadcrumbLabel = page.breadcrumbLabel ?? route.breadcrumbLabel;
    sections = page.sections ?? [];
  }
}


// Localize links in related links
const localizedRelatedLinks = relatedLinks.map((link) => ({
  ...link,
  path: localizeHref(link.path, lang, routing),
}));

---

<ArticlePage
  route={route}
  lang={lang}
  currentPath={currentPath}
  intro={intro}
  sections={sections}
  faq={faq}
  relatedLinks={localizedRelatedLinks}
/>
