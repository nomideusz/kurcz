---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHeader from '../components/PageHeader.astro';
import { poradnikiHub, poradnikiHubRoute } from '../content/poradniki-hub.js';
import { withTrailingSlash } from '../i18n/config.ts';

const route = poradnikiHubRoute;
const { categories } = poradnikiHub;
---

<Layout route={route}>
  <Shell currentPath="/poradniki">
    <Breadcrumbs route={route} />
    <PageHeader title={poradnikiHub.h1} intro={poradnikiHub.intro} eyebrow="kompendium wiedzy" />

    <div class="mx-auto max-w-7xl px-5 py-12 sm:px-14">
      <!-- Quick category jump pills -->
      <nav aria-label="Kategorie poradników" class="mb-12 flex flex-wrap gap-2.5 border-b border-line-soft pb-6">
        <span class="font-mono text-xs uppercase tracking-wider text-faint self-center mr-2">Działy:</span>
        {
          categories.map((category, idx) => (
            <a
              href={`#kat-${idx}`}
              class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-card px-3.5 py-2 text-xs font-medium text-ink transition-all hover:border-accent-border hover:bg-accent-bg hover:text-accent"
            >
              <span>{category.title}</span>
              <span class="text-accent font-mono text-[11px]">({category.guides.length})</span>
            </a>
          ))
        }
      </nav>

      {
        categories.map((category, idx) => (
          <section id={`kat-${idx}`} class="mb-16 scroll-mt-24">
            <div class="mb-6 max-w-[720px]">
              <span class="font-serif text-sm font-semibold text-accent">0{idx + 1}</span>
              <h2 class="mt-1 text-2xl text-ink sm:text-[30px]">{category.title}</h2>
              <p class="mt-2 text-[15.5px] leading-relaxed text-muted">{category.description}</p>
            </div>
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {category.guides.map((guide) => (
                <li>
                  <a
                    href={withTrailingSlash(guide.path)}
                    class="group flex h-full flex-col justify-between rounded-xl border border-line bg-card p-6 transition-all duration-200 hover:-translate-y-1 hover:border-accent-border hover:bg-card-elevated hover:shadow-md"
                  >
                    <div>
                      <h3 class="text-xl leading-snug text-ink group-hover:text-accent transition-colors">
                        {guide.title}
                      </h3>
                      <p class="mt-2.5 text-sm leading-relaxed text-muted">
                        {guide.description}
                      </p>
                    </div>
                    <div class="mt-6 flex items-center justify-between border-t border-line-soft pt-3 text-xs font-medium text-accent">
                      <span>czytaj artykuł</span>
                      <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Shell>
</Layout>

