---
// Wordmark: "kurcz.pl" lettered like a chart's title; it takes the colour of its ground.
interface Props {
  class?: string;
}
const { class: className = 'text-[2rem]' } = Astro.props;
---

<span class:list={['inline-flex items-baseline font-head font-semibold leading-none tracking-[-0.01em]', className]}>kurcz.pl</span>
