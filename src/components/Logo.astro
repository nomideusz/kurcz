---
// Wordmark: wide label lettering "kurcz" with a gold ".pl", set on the green label.
interface Props {
  class?: string;
}
const { class: className = 'text-[1.75rem]' } = Astro.props;
---

<span class:list={['inline-flex items-baseline font-head font-extrabold leading-none tracking-[-0.02em] text-on-label [--wdth:135]', className]}
  >kurcz<span class="text-gold">.pl</span></span
>
