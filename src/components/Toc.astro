---
// Sticky in-article table of contents, built from section headings with dynamic scroll-spy.
import { extractLocale, routing, t, type SupportedLocale } from '../i18n/config.ts';
import { slugify } from '../utils/slug.js';

// `inline`: the collapsible contents block at the top of the article below lg.
const { sections = [], currentPath = Astro.url.pathname, lang, inline = false } = Astro.props as {
  sections?: any[];
  currentPath?: string;
  lang?: SupportedLocale;
  inline?: boolean;
};
const { locale } = extractLocale(currentPath, routing);
const effectiveLang = lang ?? locale;

const items = sections.filter((s) => s.heading).map((s) => ({ id: slugify(s.heading), label: s.heading }));
const heading = t(effectiveLang, 'toc.heading');
---

{
  items.length >= 3 && inline && (
    <details class="group mb-10 border-y-2 border-label lg:hidden">
      <summary class="flex list-none items-center justify-between py-3.5 [&::-webkit-details-marker]:hidden">
        <span class="tag first-letter:uppercase">{heading}{" "}<span class="font-sans font-normal text-muted">({items.length})</span></span>
        <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
      </summary>
      <ol class="border-t border-rule">
        {items.map((it) => (
          <li>
            <a href={`#${it.id}`} class="flex items-start gap-3 border-b border-rule py-2.5 text-[0.9375rem] leading-snug text-ink last:border-b-0 hover:bg-wash">
              <span class="mt-[0.4em] h-2.5 w-2.5 flex-none rounded-full border-2 border-label" aria-hidden="true" />
              <span>{it.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

{
  items.length >= 3 && !inline && (
    <aside class="composition sticky top-[96px] hidden max-h-[calc(100vh-120px)] self-start overflow-y-auto lg:block">
      <h2 class="tag bg-label px-4 py-3 text-on-label first-letter:uppercase">{heading}</h2>
      <nav id="article-toc" aria-label={heading}>
        <ol class="composition rounded-none shadow-none">
          {items.map((it, i) => (
            <li>
              <a
                href={`#${it.id}`}
                data-toc-id={it.id}
                aria-current={i === 0 ? 'true' : undefined}
                class="toc-link group flex items-start gap-3 px-4 py-2.5 text-[0.9375rem] leading-snug text-muted transition-colors hover:text-ink aria-[current=true]:bg-wash aria-[current=true]:font-bold aria-[current=true]:text-ink"
              >
                <span class="mt-[0.4em] h-2.5 w-2.5 flex-none rounded-full border-2 border-label transition-colors group-aria-[current=true]:scale-125 group-aria-[current=true]:bg-label" aria-hidden="true" />
                <span>{it.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script is:inline>
  function initTocScrollSpy() {
    var tocNav = document.getElementById('article-toc');
    if (!tocNav) return;

    var links = Array.prototype.slice.call(tocNav.querySelectorAll('.toc-link'));
    if (!links.length) return;

    var headings = [];
    links.forEach(function (link) {
      var id = link.getAttribute('data-toc-id');
      var el = id ? document.getElementById(id) : null;
      if (el) {
        headings.push({ id: id, element: el, link: link });
      }
    });

    if (!headings.length) return;

    function setActive(activeId) {
      if (!activeId) return;
      links.forEach(function (l) {
        if (l.getAttribute('data-toc-id') === activeId) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    }

    function getActiveHeadingId() {
      if (headings.length === 0) return null;

      var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      var scrollPosition = window.scrollY || document.documentElement.scrollTop;
      var documentHeight = document.documentElement.scrollHeight;

      // 1. If at the top of the page before first section
      if (scrollPosition < 160) {
        return headings[0].id;
      }

      var articleEl = document.querySelector('article') || document.querySelector('.prose-content');
      var articleBottom = articleEl ? articleEl.getBoundingClientRect().bottom : documentHeight;

      // 2. If scrolled near the bottom of document or article has finished
      if (scrollPosition + viewportHeight >= documentHeight - 50 || articleBottom <= viewportHeight * 0.65) {
        return headings[headings.length - 1].id;
      }

      // 3. Headline detection zone: from sticky header bottom (~80px) to upper viewport (~35% of screen height)
      var topOffset = 80;
      var bottomOffset = Math.max(topOffset + 120, Math.min(320, viewportHeight * 0.38));

      var inZoneHeadings = [];
      var lastAboveHeading = null;

      for (var i = 0; i < headings.length; i++) {
        var top = headings[i].element.getBoundingClientRect().top;
        if (top >= topOffset && top <= bottomOffset) {
          inZoneHeadings.push(headings[i]);
        } else if (top < topOffset) {
          lastAboveHeading = headings[i];
        }
      }

      // If one or more headings are in the active headline zone (visible in top 35%),
      // the first/topmost of them is active (both scrolling down and scrolling up)
      if (inZoneHeadings.length > 0) {
        return inZoneHeadings[0].id;
      }

      // If no heading is in the zone, the user is in the middle of the last heading scrolled above the topOffset
      if (lastAboveHeading) {
        return lastAboveHeading.id;
      }

      return headings[0].id;
    }

    var ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          var activeId = getActiveHeadingId();
          setActive(activeId);
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    links.forEach(function (link) {
      link.addEventListener('click', function () {
        var targetId = this.getAttribute('data-toc-id');
        if (targetId) {
          setActive(targetId);
        }
      });
    });

    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTocScrollSpy);
  } else {
    initTocScrollSpy();
  }
  document.addEventListener('astro:page-load', initTocScrollSpy);
</script>

