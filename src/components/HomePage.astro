---
// Home page for every locale; the PL root and /[lang] pages both render this.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import FaqAccordion from './FaqAccordion.astro';
import CompositionRow from './CompositionRow.astro';
import ReliefSteps from './ReliefSteps.astro';
import { guidePlate } from '../content/plates.ts';
import { guideMinutes } from '../utils/reading.ts';
import { Image } from 'astro:assets';
import heroPlate from '../../assets/plates/hero-plate.png';
import lydekPlate from '../../assets/plates/card-lydek-plate.png';
import nocnePlate from '../../assets/plates/card-nocne-plate.png';
import ciazaPlate from '../../assets/plates/card-ciaza-plate.png';
import stopyPlate from '../../assets/plates/card-stopy-plate.png';
import dloniePlate from '../../assets/plates/card-magnez-plate.png';
import seniorzyPlate from '../../assets/plates/card-seniorzy-plate.png';
import Icon from './Icon.astro';
import { getRouteByPath } from '../seo/routes.js';
import { getFaqItems } from '../seo/faq-data.js';
import { DEFAULT_LOCALE, t, localizeHref, routing, type SupportedLocale } from '../i18n/config.ts';
import { getLocalizedRoute, getLocalizedTopics, getLocalizedDoctorSigns } from '../i18n/content.ts';

const { lang } = Astro.props as { lang: SupportedLocale };
const en = lang === 'en';
const href = (path: string) => localizeHref(path, lang, routing);
const currentPath = lang === DEFAULT_LOCALE ? '/' : `/${lang}`;
const route = getLocalizedRoute(getRouteByPath('/'), lang);

const doctorSigns = getLocalizedDoctorSigns(lang);
const homeFaq = getFaqItems(lang).slice(0, 4);

const triageItems = [
  { path: '/kurcze-lydek', icon: 'calf', title: en ? 'Calf Cramps' : 'Kurcze łydek', desc: en ? 'Sudden tightening after workouts or during movement.' : 'Nagłe spięcie po wysiłku lub przy niefortunnym ruchu.' },
  { path: '/kurcze-nocne', icon: 'night', title: en ? 'Night Cramps' : 'Kurcze nocne', desc: en ? 'Painful nighttime wakeups and evening prevention.' : 'Bolesne wybudzenia ze snu i wieczorna profilaktyka.' },
  { path: '/kurcze-u-kobiet-w-ciazy', icon: 'pregnancy', title: en ? 'Pregnancy Cramps' : 'Kurcze w ciąży', desc: en ? 'Safe positioning and gentle relief for expectant mothers.' : 'Bezpieczne pozycje, odpoczynek i ulga dla przyszłych mam.' },
  { path: '/kurcze-stop', icon: 'foot', title: en ? 'Foot Cramps' : 'Kurcze stóp', desc: en ? 'Plantar arch spasms and toe curling relief.' : 'Bolesne kurcze łuku podeszwowego i wykręcanie palców.' },
  { path: '/niedobor-magnezu', icon: 'magnesium', title: en ? 'Magnesium Deficiency' : 'Niedobór magnezu', desc: en ? 'Symptoms of deficit, bioavailability, and food sources.' : 'Objawy deficytu, przyswajalność i zbilansowana dieta.' },
  { path: '/kurcze-u-sportowcow', icon: 'sport', title: en ? 'Athletes & Runners' : 'Dla sportowców', desc: en ? 'Electrolyte loss in sweat, hydration, and recovery.' : 'Utrata soli w pocie, nawodnienie i regeneracja powysiłkowa.' },
  { path: '/kurcze-dloni', icon: 'hand', title: en ? 'Hand Cramps' : 'Kurcze dłoni', desc: en ? 'Strain from mouse, keyboard, or manual tasks.' : 'Napięcia od pracy przy komputerze, pisania i pracy manualnej.' },
  { path: '/kurcze-u-osob-starszych', icon: 'senior', title: en ? 'Senior Health' : 'U seniorów', desc: en ? 'Circulation, diuretic medications, and gentle mobility.' : 'Wpływ krążenia obwodowego, leków i bezpieczna aktywność.' },
];

// The comp's six mini wall charts, then the two remaining guides; each shows its own
// engraved vignette.
const chartCards = [
  { path: '/kurcze-lydek', plate: lydekPlate },
  { path: '/kurcze-nocne', plate: nocnePlate },
  { path: '/kurcze-u-kobiet-w-ciazy', plate: ciazaPlate },
  { path: '/kurcze-stop', plate: stopyPlate },
  { path: '/kurcze-dloni', plate: dloniePlate },
  { path: '/kurcze-u-osob-starszych', plate: seniorzyPlate },
  { path: '/kurcze-u-sportowcow', plate: guidePlate('/kurcze-u-sportowcow')!.src },
  { path: '/niedobor-magnezu', plate: guidePlate('/niedobor-magnezu')!.src },
].map((c) => ({ ...c, title: triageItems.find((i) => i.path === c.path)!.title }));

// The hero plate's three blank callout discs, lettered here so they never read as the
// rail's relief steps. Positions are disc centres as % of the plate.
const plateMarks = [
  { key: 'A', x: 82.42, y: 34.72, label: en ? 'gastrocnemius (calf) muscle' : 'mięsień brzuchaty łydki' },
  { key: 'B', x: 65.89, y: 69.01, label: en ? 'Achilles tendon' : 'ścięgno Achillesa' },
  { key: 'C', x: 36.0, y: 95.75, label: en ? 'sole muscles' : 'mięśnie podeszwy stopy' },
];

// Topics plus the two therapy guides not already linked above, as one ruled list.
const sections = [
  ...getLocalizedTopics(lang),
  { path: '/rozciaganie-przy-kurczach', title: en ? 'Activity & Stretching' : 'Aktywność i rozciąganie', desc: en ? 'Proper muscle stretching after exercise and before bed reduces sudden painful cramps.' : 'Prawidłowe rozciąganie mięśni po treningu i przed snem ogranicza ryzyko nagłych, bolesnych kurczy.' },
  { path: '/masaz-przy-kurczach', title: en ? 'Massage & Physical Therapy' : 'Masaż i terapia fizyczna', desc: en ? 'Targeted myofascial massage and manual therapy promote fast recovery after acute cramps.' : 'Okrężny masaż powięziowy i terapia manualna wspomagają szybki powrót do sprawności po ostrym kurczu.' },
];
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <!-- THE CHART: title and lead on the linen, the engraved leg bleeding off the top right -->
    <section class="relative px-4 pt-8 sm:px-8 lg:min-h-[calc(var(--u)*29.55)] lg:px-0 lg:pl-[calc(var(--u)*3.47)] lg:pt-[calc(var(--u)*3.3)]">
      <figure class="hero-plate relative mx-auto mb-6 w-full max-w-[34rem] [container-type:inline-size] lg:absolute lg:right-0 lg:top-[calc(var(--u)*1.2)] lg:z-0 lg:mb-0 lg:w-[calc(var(--u)*43.8)] lg:max-w-none lg:[mask-image:linear-gradient(transparent,#000_9%)]">
        <Image
          src={heroPlate}
          width={1536}
          alt={en ? 'Engraved plate of the lower leg and foot from the side, with the calf, Achilles tendon and sole muscles marked.' : 'Rycina podudzia i stopy z boku z zaznaczonym mięśniem łydki, ścięgnem Achillesa i mięśniami podeszwy stopy.'}
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
        {/* top is a share of the image height, set in cqw so a legend below the image doesn't move it */}
        {
          plateMarks.map((m, i) => (
            <span class="plate-mark" style={`left:${m.x}%;top:calc(${(m.y * heroPlate.height) / heroPlate.width}cqw);--i:${i}`} aria-hidden="true">{m.key}</span>
          ))
        }
        <figcaption class="plate-legend">
          <ol>
            {plateMarks.map((m) => <li><span class="plate-key" aria-hidden="true">{m.key}</span> {m.label}</li>)}
          </ol>
        </figcaption>
      </figure>

      <div class="relative z-10 lg:max-w-[calc(var(--u)*36)]">
        <h1 class="text-[clamp(3rem,13vw,4.5rem)] font-bold leading-[1] tracking-[-0.015em] lg:text-[calc(var(--u)*6.3)]">
          {t(lang, 'hero.h1')}
        </h1>
        <p class="mt-4 max-w-[34rem] text-[1.25rem] [font-variation-settings:'wdth'_88] leading-[1.3] text-ink lg:mt-[calc(var(--u)*1.55)] lg:max-w-[calc(var(--u)*31.6)] lg:text-[max(1.25rem,calc(var(--u)*1.72))] lg:leading-[1.2]">
          {t(lang, 'hero.p')}
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:ml-[calc(var(--u)*0.2)] lg:mt-[calc(var(--u)*1.3)] lg:gap-[calc(var(--u)*1.65)]">
          <a href={href('/pierwsza-pomoc')} class="btn-solid lg:min-h-[calc(var(--u)*4.03)] lg:min-w-[calc(var(--u)*16.4)] lg:text-[max(1.125rem,calc(var(--u)*1.6))] lg:font-semibold">{t(lang, 'hero.first_aid_btn')}</a>
          <a href={href('/kurcze-miesniowe')} class="btn-line lg:min-h-[calc(var(--u)*4.03)] lg:min-w-[calc(var(--u)*16.4)] lg:text-[max(1.125rem,calc(var(--u)*1.6))] lg:font-semibold">{t(lang, 'hero.causes_btn')}</a>
        </div>
      </div>
      <hr class="mt-10 border-t-2 border-slate/70 lg:absolute lg:bottom-0 lg:left-[calc(var(--u)*0.32)] lg:m-0 lg:w-[calc(var(--u)*38.74)]" />
    </section>

    <!-- QUICK RELIEF on a phone: the rail's cloth panel, here in the page since the rail folds away -->
    <section class="cloth-strip mx-4 mt-8 rounded-[7px] px-5 pb-3 pt-4 sm:mx-8 lg:hidden" aria-labelledby="relief-home-title">
      <h2 id="relief-home-title" class="text-[1.5rem] font-bold text-on-slate">
        <a href={href('/pierwsza-pomoc')} class="rail-link">{t(lang, 'relief.title')}</a>
      </h2>
      <ReliefSteps locale={lang} class="mt-1" />
    </section>

    <!-- WHERE AND WHEN: mini wall charts, a cloth title strip over an engraved vignette -->
    <section class="px-4 pt-10 sm:px-8 lg:px-0 lg:pl-[calc(var(--u)*3.2)] lg:pr-[calc(var(--u)*4.8)] lg:pt-[calc(var(--u)*1.45)]">
      <h2 class="text-[1.875rem] font-bold sm:text-[2.25rem] lg:text-[calc(var(--u)*3)]">
        {en ? 'Where and when do your cramps happen?' : 'Gdzie i kiedy pojawia się kurcz?'}
      </h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:mt-[calc(var(--u)*0.7)] lg:grid-cols-[21.55fr_23.24fr_24.67fr] lg:grid-rows-[calc(var(--u)*14.52)] lg:auto-rows-[calc(var(--u)*13.09)] lg:gap-x-[calc(var(--u)*1.07)] lg:gap-y-[calc(var(--u)*1.04)]">
        {
          chartCards.map((c) => {
            const min = guideMinutes(href(c.path));
            return (
              <li>
                <a href={href(c.path)} class="chart-card">
                  <h3 class="chart-card-title">{c.title}</h3>
                  <Image src={c.plate} width={960} loading="eager" alt="" class="chart-card-plate" />
                  {min && <span class="chart-card-time">~{min} min</span>}
                </a>
              </li>
            );
          })
        }
        <li>
          <a href={href('/poradniki')} class="chart-card group">
            <h3 class="chart-card-title">{en ? 'All guides' : 'Wszystkie poradniki'}</h3>
            <span class="flex flex-1 flex-col items-center justify-center gap-3 text-center">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-ochre text-paper shadow-[inset_0_0_0_2px_rgb(60_42_12/0.25)] transition-transform group-hover:translate-x-1 lg:h-[calc(var(--u)*3.6)] lg:w-[calc(var(--u)*3.6)]">
                <Icon name="arrow" class="h-7 w-7 lg:h-[calc(var(--u)*1.8)] lg:w-[calc(var(--u)*1.8)]" />
              </span>
              <span class="text-lg font-medium text-ink lg:text-[max(1.0625rem,calc(var(--u)*1.35))]">{en ? 'the full index of topics' : 'pełny spis tematów'}</span>
            </span>
          </a>
        </li>
      </ul>
    </section>

    <!-- TOPICS: the chart index, each row with its plate -->
    <section class="page-x mt-16 lg:mt-[calc(var(--u)*4)]">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-2 border-t-2 border-slate/70 pt-4">
        <h2 class="text-[1.875rem] font-bold sm:text-[2.25rem] lg:text-[calc(var(--u)*3)]">{t(lang, 'topics.title')}</h2>
        <a href={href('/poradniki')} class="ink-link inline-flex items-center gap-1.5 font-bold">
          {en ? 'All guides' : 'Wszystkie poradniki'} <Icon name="arrow" class="h-[1.1em] w-[1.1em] flex-none" />
        </a>
      </div>
      <ul class="chart-table mt-5 grid sm:grid-cols-2">
        {sections.map((item) => <CompositionRow href={href(item.path)} title={item.title} desc={item.desc} as="h3" thumb />)}
      </ul>
    </section>

    <!-- WHEN TO SEE A DOCTOR: the one red frame; every flag carries an icon, not colour alone -->
    <section class="page-x mt-16 lg:mt-[calc(var(--u)*4)]" aria-labelledby="doctor-title">
      <div class="chart-frame chart-frame-warn">
        <h2 id="doctor-title" class="cloth-strip cloth-strip-warn flex items-center gap-3 px-4 py-2.5 text-[1.625rem] font-bold text-on-slate sm:px-5 sm:text-[2rem]">
          <Icon name="warning" class="h-7 w-7 flex-none sm:h-8 sm:w-8" />
          {t(lang, 'doctor.title')}
        </h2>
        <div class="grid gap-x-12 px-4 pb-2 pt-4 sm:px-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
          <p class="max-w-[30rem] text-lg leading-relaxed text-body md:pt-3">{t(lang, 'doctor.p')}</p>
          <ul class="mt-2 md:mt-0">
            {
              doctorSigns.map((s) => (
                <li class="flex items-start gap-3.5 border-b border-rule py-3.5 text-[1.0625rem] font-semibold leading-snug text-ink last:border-b-0">
                  <Icon name="warning" class="mt-px h-6 w-6 flex-none text-madder-deep" />
                  <span>{s}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="page-x mt-16 lg:mt-[calc(var(--u)*4)]">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-2 border-t-2 border-slate/70 pt-4">
        <h2 class="text-[1.875rem] font-bold sm:text-[2.25rem] lg:text-[calc(var(--u)*3)]">{t(lang, 'faq.title')}</h2>
        <a href={href('/faq')} class="ink-link inline-flex items-center gap-1.5 font-bold">{t(lang, 'faq.see_all')} <Icon name="arrow" class="h-[1.1em] w-[1.1em] flex-none" /></a>
      </div>
      <p class="mt-2 max-w-[44rem] text-lg text-muted">{t(lang, 'faq.intro')}</p>
      <div class="mt-5 max-w-[56rem]">
        <FaqAccordion items={homeFaq} bare />
      </div>
    </section>
  </Shell>
</Layout>
