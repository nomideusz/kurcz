---
// Hub and service page header: the box band. Crumbs render inside when a route is passed.
import Breadcrumbs from './Breadcrumbs.astro';
const { title, intro, route, currentPath } = Astro.props;
---

<header class="bg-spot">
  <div class="mx-auto max-w-[1240px] px-4 pb-12 pt-8 sm:px-8 sm:pb-14">
    {route && <Breadcrumbs route={route} currentPath={currentPath} />}
    <h1 class="mt-6 max-w-[52rem] text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.96] tracking-[-0.02em]">{title}</h1>
    {intro && <p class="mt-5 max-w-[44rem] text-[1.1875rem] leading-relaxed text-ink">{intro}</p>}
  </div>
</header>
