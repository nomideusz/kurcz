---
// Hub and service page header: the green label band with its wave edge. Crumbs render inside when a route is passed.
import Breadcrumbs from './Breadcrumbs.astro';
const { title, intro, route, currentPath } = Astro.props;
---

<header class="label-band wave">
  <div class="mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-8 sm:pb-16">
    {route && <Breadcrumbs route={route} currentPath={currentPath} />}
    <h1 class="mt-6 max-w-[52rem] text-[clamp(2.25rem,5.4vw,4rem)] leading-[1] tracking-[-0.025em] [--wdth:125]">{title}</h1>
    {intro && <p class="mt-5 max-w-[44rem] text-[1.1875rem] leading-relaxed text-on-label">{intro}</p>}
  </div>
</header>
