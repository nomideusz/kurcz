---
import { extractLocale, routing, t, type SupportedLocale } from '../i18n/config.ts';

const { currentPath = Astro.url.pathname, lang } = Astro.props as {
  currentPath?: string;
  lang?: SupportedLocale;
};
const { locale } = extractLocale(currentPath, routing);
const effectiveLocale = lang ?? locale;
---

<form id="contact-form" class="space-y-5 rounded-2xl border border-line bg-card p-6 sm:p-8 shadow-xs" novalidate data-lang={effectiveLocale}
  data-msg-sending={t(effectiveLocale, 'contact.sending')}
  data-msg-success={t(effectiveLocale, 'contact.success')}
  data-msg-error={t(effectiveLocale, 'contact.error')}
  data-msg-offline={t(effectiveLocale, 'contact.offline')}>
  <div>
    <label for="cf-name" class="block text-sm font-medium text-ink">{t(effectiveLocale, 'contact.name')}</label>
    <input
      id="cf-name"
      name="from_name"
      type="text"
      required
      maxlength="120"
      autocomplete="name"
      class="mt-2 block w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink transition-all placeholder:text-muted/60 focus:border-accent focus:bg-card-elevated focus:outline-none focus:ring-2 focus:ring-accent/20"
    />
  </div>
  <div>
    <label for="cf-email" class="block text-sm font-medium text-ink">{t(effectiveLocale, 'contact.email')}</label>
    <input
      id="cf-email"
      name="reply_to"
      type="email"
      required
      autocomplete="email"
      class="mt-2 block w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink transition-all placeholder:text-muted/60 focus:border-accent focus:bg-card-elevated focus:outline-none focus:ring-2 focus:ring-accent/20"
    />
  </div>
  <div>
    <label for="cf-message" class="block text-sm font-medium text-ink">{t(effectiveLocale, 'contact.message')}</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      minlength="5"
      maxlength="5000"
      class="mt-2 block w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink transition-all placeholder:text-muted/60 focus:border-accent focus:bg-card-elevated focus:outline-none focus:ring-2 focus:ring-accent/20"
    ></textarea>
  </div>

  <!-- Honeypot: hidden from humans, bots fill it -->
  <div class="absolute -left-[5000px]" aria-hidden="true">
    <label>
      {effectiveLocale === 'en' ? 'Do not fill this field' : 'Nie wypełniaj tego pola'}
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button
    type="submit"
    id="cf-submit"
    class="inline-flex items-center justify-center rounded-xl bg-accent px-8 py-3.5 text-sm font-medium text-paper transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60"
  >
    {t(effectiveLocale, 'contact.send')}
  </button>
  <p id="cf-status" role="status" aria-live="polite" class="text-sm font-medium"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('cf-status')!;
    const submit = document.getElementById('cf-submit') as HTMLButtonElement;
    const formLang = form.dataset.lang || 'pl';
    const msg = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      submit.disabled = true;
      status.textContent = msg.msgSending!;
      status.className = 'text-sm text-muted';

      const payload = Object.fromEntries(new FormData(form).entries());
      payload.lang = formLang;

      try {
        // Trailing slash is required: astro.config sets trailingSlash: 'always', so the
        // Netlify function is registered at /api/contact/ and the bare path 404s to HTML.
        const res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          status.textContent = msg.msgSuccess!;
          status.className = 'text-sm text-accent';
          form.reset();
        } else {
          // A non-JSON response (404 HTML, proxy error) leaves data.error undefined and
          // the visitor sees only the generic string — log enough to name the cause.
          console.error('[contact] submit failed', res.status, res.statusText, data);
          status.textContent = data.error ?? msg.msgError!;
          status.className = 'text-sm text-red-600';
        }
      } catch {
        status.textContent = msg.msgOffline!;
        status.className = 'text-sm text-red-600';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
