---
import { extractLocale, routing, t, type SupportedLocale } from '../i18n/config.ts';

const { currentPath = Astro.url.pathname, lang } = Astro.props as {
  currentPath?: string;
  lang?: SupportedLocale;
};
const { locale } = extractLocale(currentPath, routing);
const effectiveLocale = lang ?? locale;
---

<form id="contact-form" class="space-y-6 border border-ink bg-sheet p-5 sm:p-8" novalidate data-lang={effectiveLocale}
  data-msg-sending={t(effectiveLocale, 'contact.sending')}
  data-msg-success={t(effectiveLocale, 'contact.success')}
  data-msg-error={t(effectiveLocale, 'contact.error')}
  data-msg-offline={t(effectiveLocale, 'contact.offline')}>
  <div>
    <label for="cf-name" class="block text-base font-bold text-ink">{t(effectiveLocale, 'contact.name')}</label>
    <input
      id="cf-name"
      name="from_name"
      type="text"
      required
      maxlength="120"
      autocomplete="name"
      class="mt-2 block w-full rounded-xs border border-ink bg-paper px-4 py-3 text-[1.0625rem] text-ink focus:bg-sheet"
    />
  </div>
  <div>
    <label for="cf-email" class="block text-base font-bold text-ink">{t(effectiveLocale, 'contact.email')}</label>
    <input
      id="cf-email"
      name="reply_to"
      type="email"
      required
      autocomplete="email"
      class="mt-2 block w-full rounded-xs border border-ink bg-paper px-4 py-3 text-[1.0625rem] text-ink focus:bg-sheet"
    />
  </div>
  <div>
    <label for="cf-message" class="block text-base font-bold text-ink">{t(effectiveLocale, 'contact.message')}</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      minlength="5"
      maxlength="5000"
      class="mt-2 block w-full rounded-xs border border-ink bg-paper px-4 py-3 text-[1.0625rem] text-ink focus:bg-sheet"
    ></textarea>
  </div>

  <!-- Honeypot: hidden from humans, bots fill it -->
  <div class="absolute -left-[5000px]" aria-hidden="true">
    <label>
      {effectiveLocale === 'en' ? 'Do not fill this field' : 'Nie wypełniaj tego pola'}
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button
    type="submit"
    id="cf-submit"
    class="btn-ink px-8 disabled:bg-[#8a8a85]"
  >
    {t(effectiveLocale, 'contact.send')}
  </button>
  <p id="cf-status" role="status" aria-live="polite" class="text-sm font-medium"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('cf-status')!;
    const submit = document.getElementById('cf-submit') as HTMLButtonElement;
    const formLang = form.dataset.lang || 'pl';
    const msg = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      submit.disabled = true;
      status.textContent = msg.msgSending!;
      status.className = 'text-base text-muted';

      const payload = Object.fromEntries(new FormData(form).entries());
      payload.lang = formLang;

      try {
        // Trailing slash is required: astro.config sets trailingSlash: 'always', so the
        // Netlify function is registered at /api/contact/ and the bare path 404s to HTML.
        const res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          status.textContent = msg.msgSuccess!;
          status.className = 'border-2 border-ink bg-spot-wash p-3 text-base font-bold text-ink';
          form.reset();
        } else {
          // A non-JSON response (404 HTML, proxy error) leaves data.error undefined and
          // the visitor sees only the generic string — log enough to name the cause.
          console.error('[contact] submit failed', res.status, res.statusText, data);
          status.textContent = data.error ?? msg.msgError!;
          status.className = 'border-2 border-warn p-3 text-base font-bold text-warn';
        }
      } catch {
        status.textContent = msg.msgOffline!;
        status.className = 'border-2 border-warn p-3 text-base font-bold text-warn';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
