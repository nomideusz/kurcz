---
// Native <details> accordion — accessible, zero JS. Rows ruled inside one rinse panel.
// `bare`: render only the list (no <section>/heading), for embedding in a column.
const { items = [], heading = 'Najczęściej zadawane pytania', bare = false } = Astro.props;
---

{
  items.length > 0 &&
    (bare ? (
      <div class="composition">
        {items.map((item) => (
          <details class="group border-b border-rule last:border-b-0">
            <summary class="flex list-none items-start justify-between gap-4 px-5 py-5 transition-colors select-none hover:bg-wash sm:px-6 [&::-webkit-details-marker]:hidden">
              <h3 class="text-[1.1875rem] leading-snug [--wdth:110]">{item.question}</h3>
              <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-full border-2 border-label text-label transition-colors group-open:bg-label group-open:text-on-label">
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 14 14" stroke="currentColor" stroke-width="2.2">
                  <path d="M7 1v12M1 7h12" />
                </svg>
              </span>
            </summary>
            <p class="max-w-[68ch] px-5 pb-6 text-[1.0625rem] leading-relaxed text-body sm:px-6">{item.answer}</p>
          </details>
        ))}
      </div>
    ) : (
      <section class="mx-auto max-w-[1240px] px-4 py-14 sm:px-8">
        <div class="max-w-[52rem]">
          <h2 class="mb-6 text-[1.875rem] sm:text-[2.25rem]">{heading}</h2>
          <Astro.self items={items} bare />
        </div>
      </section>
    ))
}
