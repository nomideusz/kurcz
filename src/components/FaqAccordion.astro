---
// Native <details> accordion — accessible, zero JS. Ruled leaflet rows, no cards.
// `bare`: render only the list (no <section>/heading), for embedding in a column.
const { items = [], heading = 'Najczęściej zadawane pytania', bare = false } = Astro.props;
---

{
  items.length > 0 &&
    (bare ? (
      <div class="border-t-2 border-ink">
        {items.map((item) => (
          <details class="group border-b border-ink">
            <summary class="flex list-none items-start justify-between gap-4 px-1 py-5 transition-colors select-none hover:bg-spot-wash [&::-webkit-details-marker]:hidden">
              <h3 class="text-[1.375rem] leading-snug">{item.question}</h3>
              <span aria-hidden="true" class="mt-1 flex h-7 w-7 flex-none items-center justify-center border border-ink transition-colors group-open:bg-spot">
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 14 14" stroke="currentColor" stroke-width="2.2">
                  <path d="M7 1v12M1 7h12" />
                </svg>
              </span>
            </summary>
            <p class="max-w-[68ch] px-1 pb-6 text-[1.0625rem] leading-relaxed text-body">{item.answer}</p>
          </details>
        ))}
      </div>
    ) : (
      <section class="mx-auto max-w-[1240px] px-4 py-14 sm:px-8">
        <div class="max-w-[52rem]">
          <h2 class="mb-6 text-[2rem] sm:text-[2.5rem]">{heading}</h2>
          <Astro.self items={items} bare />
        </div>
      </section>
    ))
}
