---
// Article / guide / static page for every locale: the green label header over a rinse reading panel.
// The page files resolve content per locale; this component only renders it.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ContentSections from './ContentSections.astro';
import FaqAccordion from './FaqAccordion.astro';
import RelatedLinks from './RelatedLinks.astro';
import Toc from './Toc.astro';
import Icon from './Icon.astro';
import { t, localizeHref, routing, type SupportedLocale } from '../i18n/config.ts';
import { getLocalizedDoctorSigns } from '../i18n/content.ts';
import { readMinutes } from '../utils/reading.ts';

const { route, lang, currentPath, intro = '', sections = [], faq = [], relatedLinks = [] } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  intro?: string;
  sections?: any[];
  faq?: any[];
  relatedLinks?: any[];
};
const en = lang === 'en';

const readMin = readMinutes(intro, sections);
// The PL article box has always carried a longer disclaimer than the shared footer line.
const disclaimer = en
  ? t(lang, 'disclaimer.text')
  : 'Prezentowane w portalu Kurcz.pl informacje mają wyłącznie charakter edukacyjny i opierają się na aktualnej wiedzy fizjologicznej oraz medycznej. Nie stanowią one porady lekarskiej ani diagnozy. W przypadku przewlekłych, nasilonych lub niepokojących objawów zawsze skonsultuj się z lekarzem lub fizjoterapeutą.';
const doctorSigns = getLocalizedDoctorSigns(lang);
const hasToc = sections.filter((s) => s.heading).length >= 3;
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <header class="label-band wave">
      <div class="mx-auto max-w-[1240px] px-4 pb-12 pt-8 sm:px-8 sm:pb-14">
        <Breadcrumbs route={route} currentPath={currentPath} />
        <h1 class="mt-6 max-w-[54rem] text-[clamp(2rem,4.6vw,3.5rem)] leading-[1.02] tracking-[-0.025em] [--wdth:122]">{route.h1}</h1>
        {intro && <p class="mt-6 max-w-[44rem] text-[1.1875rem] leading-relaxed text-on-label">{intro}</p>}
        <p class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-on-label-soft">
          <span class="inline-flex items-center gap-1.5"><Icon name="clock" class="h-4 w-4 text-on-label-soft" />{t(lang, 'reading_time', { min: readMin })}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="h-4 w-4 text-on-label-soft" />{t(lang, 'last_updated', { year: '2026' })}</span>
        </p>
      </div>
    </header>

    <div class:list={['mx-auto max-w-[1240px] gap-12 px-4 pt-12 sm:px-8 sm:pt-16', hasToc && 'lg:grid lg:grid-cols-[16rem_1fr] xl:gap-16']}>
      {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} />}
      <article class="min-w-0 max-w-[48rem] rounded-[var(--radius-label)] bg-sheet px-5 py-8 shadow-[0_1px_2px_rgb(8_67_47/0.08),0_10px_28px_-8px_rgb(8_67_47/0.16)] sm:px-10 sm:py-12">
        {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} inline />}
        <ContentSections sections={sections} />

        <!-- The one red panel: the flags that mean "stop reading, see a doctor". -->
        <aside class="mt-16 rounded-[var(--radius-label)] border-2 border-warn bg-warn-wash p-5 sm:p-7">
          <div class="flex items-center gap-3">
            <Icon name="warn-solid" class="h-8 w-8 flex-none" />
            <h2 class="text-[1.5rem] sm:text-[1.75rem]">{t(lang, 'doctor.title')}</h2>
          </div>
          <ul class="mt-4 border-t border-warn/30">
            {
              doctorSigns.map((sign) => (
                <li class="flex items-start gap-3.5 border-b border-warn/20 py-3.5 text-[1.0625rem] font-bold leading-snug text-ink last:border-b-0">
                  <Icon name="warning" class="mt-px h-6 w-6 flex-none text-warn" />
                  <span>{sign}</span>
                </li>
              ))
            }
          </ul>
        </aside>

        <aside class="mt-10 border-t border-rule pt-5">
          <h2 class="tag">{en ? 'Medical disclaimer' : 'Zastrzeżenie medyczne'}</h2>
          <p class="mt-2 max-w-[68ch] text-[0.9375rem] leading-relaxed text-body">
            {disclaimer}
            <a href={localizeHref('/disclaimer-medyczny', lang, routing)} class="ink-link ml-1 font-bold">{en ? 'Full disclaimer' : 'Pełne zastrzeżenie'}</a>
          </p>
        </aside>
      </article>
    </div>

    {
      faq.length > 0 && (
        <section class="mx-auto mt-20 grid max-w-[1240px] gap-8 px-4 sm:px-8 lg:grid-cols-[16rem_1fr] lg:gap-16">
          <h2 class="text-[1.75rem] sm:text-[2rem]">{t(lang, 'faq.title')}</h2>
          <div class="max-w-[48rem]">
            <FaqAccordion items={faq} bare />
          </div>
        </section>
      )
    }

    <RelatedLinks links={relatedLinks} lang={lang} currentPath={currentPath} />
  </Shell>
</Layout>
