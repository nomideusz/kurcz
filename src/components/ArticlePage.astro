---
// Article / guide / static page for every locale: the unfolded leaflet.
// The page files resolve content per locale; this component only renders it.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ContentSections from './ContentSections.astro';
import FaqAccordion from './FaqAccordion.astro';
import RelatedLinks from './RelatedLinks.astro';
import Toc from './Toc.astro';
import Icon from './Icon.astro';
import { t, localizeHref, routing, type SupportedLocale } from '../i18n/config.ts';
import { getLocalizedDoctorSigns } from '../i18n/content.ts';

const { route, lang, currentPath, intro = '', sections = [], faq = [], relatedLinks = [] } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  intro?: string;
  sections?: any[];
  faq?: any[];
  relatedLinks?: any[];
};
const en = lang === 'en';

const wordCount = (intro + ' ' + sections.map((s) => `${s.heading ?? ''} ${s.body ?? ''} ${(s.bullets ?? []).join(' ')}`).join(' '))
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const readMin = Math.max(2, Math.round(wordCount / 200));
// The PL article box has always carried a longer disclaimer than the shared footer line.
const disclaimer = en
  ? t(lang, 'disclaimer.text')
  : 'Prezentowane w portalu Kurcz.pl informacje mają wyłącznie charakter edukacyjny i opierają się na aktualnej wiedzy fizjologicznej oraz medycznej. Nie stanowią one porady lekarskiej ani diagnozy. W przypadku przewlekłych, nasilonych lub niepokojących objawów zawsze skonsultuj się z lekarzem lub fizjoterapeutą.';
const doctorSigns = getLocalizedDoctorSigns(lang);
const hasToc = sections.filter((s) => s.heading).length >= 3;
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <header class="border-b-2 border-ink">
      <div class="mx-auto max-w-[1240px] px-4 pb-10 pt-8 sm:px-8 sm:pb-12">
        <Breadcrumbs route={route} currentPath={currentPath} />
        <h1 class="mt-6 max-w-[52rem] text-[clamp(2.375rem,5.4vw,4rem)] leading-[0.98] tracking-[-0.02em]">{route.h1}</h1>
        {intro && <p class="mt-6 max-w-[44rem] text-[1.25rem] leading-relaxed text-ink">{intro}</p>}
        <p class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
          <span class="inline-flex items-center gap-1.5"><Icon name="clock" class="h-4 w-4 text-ink" />{t(lang, 'reading_time', { min: readMin })}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="h-4 w-4 text-ink" />{t(lang, 'last_updated', { year: '2026' })}</span>
        </p>
      </div>
    </header>

    <div class:list={['mx-auto max-w-[1240px] gap-16 px-4 pt-10 sm:px-8 sm:pt-12', hasToc && 'lg:grid lg:grid-cols-[16rem_1fr]']}>
      {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} />}
      <article class="min-w-0 max-w-[46rem]">
        {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} inline />}
        <ContentSections sections={sections} />

        <!-- Leaflet warning box: the red flags that mean "stop reading, see a doctor". -->
        <aside class="mt-16 border-2 border-ink bg-sheet p-5 sm:p-7">
          <div class="flex items-center gap-3">
            <Icon name="warn-solid" class="h-8 w-8 flex-none" />
            <h2 class="text-[1.75rem] sm:text-[2rem]">{t(lang, 'doctor.title')}</h2>
          </div>
          <ol class="mt-4 border-t border-ink">
            {
              doctorSigns.map((sign, i) => (
                <li class="flex items-start gap-3.5 border-b border-rule py-3.5 text-[1.0625rem] font-bold leading-snug text-ink last:border-b-0">
                  <span class="inline-flex h-7 min-w-7 flex-none items-center justify-center rounded-xs bg-warn px-1.5 font-head text-base leading-none text-sheet tabular-nums">{i + 1}</span>
                  <span>{sign}</span>
                </li>
              ))
            }
          </ol>
        </aside>

        <aside class="mt-10 border-t-2 border-ink pt-5">
          <h2 class="caps">{en ? 'Medical disclaimer' : 'Zastrzeżenie medyczne'}</h2>
          <p class="mt-2 max-w-[68ch] text-[0.9375rem] leading-relaxed text-body">
            {disclaimer}
            <a href={localizeHref('/disclaimer-medyczny', lang, routing)} class="ink-link ml-1 font-bold">{en ? 'Full disclaimer' : 'Pełne zastrzeżenie'}</a>
          </p>
        </aside>
      </article>
    </div>

    {
      faq.length > 0 && (
        <section class="mx-auto mt-20 grid max-w-[1240px] gap-8 px-4 sm:px-8 lg:grid-cols-[16rem_1fr] lg:gap-16">
          <h2 class="text-[2rem] sm:text-[2.5rem]">{t(lang, 'faq.title')}</h2>
          <div class="max-w-[46rem]">
            <FaqAccordion items={faq} bare />
          </div>
        </section>
      )
    }

    <RelatedLinks links={relatedLinks} lang={lang} currentPath={currentPath} />
  </Shell>
</Layout>
