---
// Article / guide / static page for every locale: title and the guide's engraved plate on the
// chart sheet, then one reading column with a framed contents chart beside it.
// The page files resolve content per locale; this component only renders it.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ContentSections from './ContentSections.astro';
import FaqAccordion from './FaqAccordion.astro';
import RelatedLinks from './RelatedLinks.astro';
import Toc from './Toc.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { guidePlate } from '../content/plates.ts';
import { t, localizeHref, routing, type SupportedLocale } from '../i18n/config.ts';
import { getLocalizedDoctorSigns } from '../i18n/content.ts';
import { readMinutes } from '../utils/reading.ts';

const { route, lang, currentPath, intro = '', sections = [], faq = [], relatedLinks = [] } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  intro?: string;
  sections?: any[];
  faq?: any[];
  relatedLinks?: any[];
};
const en = lang === 'en';

const readMin = readMinutes(intro, sections);
// The PL article box has always carried a longer disclaimer than the shared footer line.
const disclaimer = en
  ? t(lang, 'disclaimer.text')
  : 'Prezentowane w portalu Kurcz.pl informacje mają wyłącznie charakter edukacyjny i opierają się na aktualnej wiedzy fizjologicznej oraz medycznej. Nie stanowią one porady lekarskiej ani diagnozy. W przypadku przewlekłych, nasilonych lub niepokojących objawów zawsze skonsultuj się z lekarzem lub fizjoterapeutą.';
const doctorSigns = getLocalizedDoctorSigns(lang);
const hasToc = sections.filter((s) => s.heading).length >= 3;
const plate = guidePlate(currentPath);
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <header class="page-x pt-6 lg:pt-[calc(var(--u)*2.6)]">
      <Breadcrumbs route={route} currentPath={currentPath} />
      <div class:list={['mt-5 lg:mt-[calc(var(--u)*1.4)]', plate && 'flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_calc(var(--u)*34)] lg:items-center lg:gap-[calc(var(--u)*3)]']}>
        {
          plate && (
            <figure class="order-first mx-auto mb-6 w-full max-w-[26rem] lg:order-none lg:col-start-2 lg:row-start-1 lg:mb-0 lg:max-w-none">
              <Image src={plate.src} width={1024} alt={plate.alt} loading="eager" fetchpriority="high" class="block h-auto max-h-60 w-full object-contain lg:max-h-none" />
            </figure>
          )
        }
        <div class="lg:col-start-1 lg:row-start-1">
          <h1 class="max-w-[54rem] text-[clamp(2.25rem,6vw,3.5rem)] font-bold leading-[1.02] tracking-[-0.015em] lg:text-[max(2.75rem,calc(var(--u)*4.2))]">{route.h1}</h1>
          {intro && <p class="mt-5 max-w-[44rem] text-[1.1875rem] leading-[1.5] text-ink lg:mt-[calc(var(--u)*1.3)] lg:text-[max(1.1875rem,calc(var(--u)*1.32))]">{intro}</p>}
          <p class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" class="h-4 w-4 text-slate" />{t(lang, 'reading_time', { min: readMin })}</span>
            <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="h-4 w-4 text-slate" />{t(lang, 'last_updated', { year: '2026' })}</span>
          </p>
        </div>
      </div>
      <hr class="mt-8 hidden border-t-2 border-slate/70 lg:mt-[calc(var(--u)*2.2)] lg:block" />
    </header>

    <div class:list={['page-x pt-10 lg:pt-[calc(var(--u)*2.4)]', hasToc && 'lg:grid lg:grid-cols-[minmax(0,1fr)_calc(var(--u)*19)] lg:gap-[calc(var(--u)*3)]']}>
      {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} />}
      <article class="min-w-0 max-w-[48rem] lg:col-start-1 lg:row-start-1">
        {hasToc && <Toc sections={sections} currentPath={currentPath} lang={lang} inline />}
        <ContentSections sections={sections} />

        <!-- The one red frame: the flags that mean "stop reading, see a doctor". -->
        <aside class="chart-frame chart-frame-warn mt-16" aria-labelledby="doctor-title">
          <h2 id="doctor-title" class="cloth-strip cloth-strip-warn flex items-center gap-2.5 px-4 py-2.5 text-[1.375rem] font-semibold text-on-slate sm:text-[1.5rem]">
            <Icon name="warning" class="h-6 w-6 flex-none" />
            {t(lang, 'doctor.title')}
          </h2>
          <ul class="px-4 py-1 sm:px-5">
            {
              doctorSigns.map((sign) => (
                <li class="flex items-start gap-3.5 border-b border-rule py-3.5 text-[1.0625rem] font-semibold leading-snug text-ink last:border-b-0">
                  <Icon name="warning" class="mt-px h-6 w-6 flex-none text-madder-deep" />
                  <span>{sign}</span>
                </li>
              ))
            }
          </ul>
        </aside>

        <aside class="mt-10 border-t border-rule pt-5">
          <h2 class="tag text-slate">{en ? 'Medical disclaimer' : 'Zastrzeżenie medyczne'}</h2>
          <p class="mt-2 max-w-[68ch] text-[0.9375rem] leading-relaxed text-body">
            {disclaimer}
            <a href={localizeHref('/disclaimer-medyczny', lang, routing)} class="ink-link ml-1 font-bold">{en ? 'Full disclaimer' : 'Pełne zastrzeżenie'}</a>
          </p>
        </aside>
      </article>
    </div>

    {
      faq.length > 0 && (
        <section class="page-x mt-20">
          <h2 class="border-t-2 border-slate/70 pt-4 text-[1.75rem] sm:text-[2.125rem]">{t(lang, 'faq.title')}</h2>
          <div class="mt-5 max-w-[56rem]">
            <FaqAccordion items={faq} bare />
          </div>
        </section>
      )
    }

    <RelatedLinks links={relatedLinks} lang={lang} currentPath={currentPath} />
  </Shell>
</Layout>
