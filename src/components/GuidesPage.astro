---
// Guides hub for every locale: a box-band header, then each category as a ruled index.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import PageHeader from './PageHeader.astro';
import { withTrailingSlash, type SupportedLocale } from '../i18n/config.ts';

const { route, lang, currentPath, title, intro, categories } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  title: string;
  intro: string;
  categories: { title: string; description: string; guides: { path: string; title: string; description: string }[] }[];
};
const en = lang === 'en';
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <PageHeader title={title} intro={intro} route={route} currentPath={currentPath} />

    <nav aria-label={en ? 'Guide categories' : 'Kategorie poradników'} class="border-b border-ink">
      <ul class="mx-auto flex max-w-[1240px] flex-wrap gap-x-6 gap-y-1 px-4 py-4 sm:px-8">
        {
          categories.map((category, idx) => (
            <li>
              <a href={`#kat-${idx}`} class="ink-link inline-block py-1 text-[0.9375rem] font-bold">
                {category.title} <span class="font-normal text-muted">({category.guides.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mx-auto max-w-[1240px] px-4 sm:px-8">
      {
        categories.map((category, idx) => (
          <section id={`kat-${idx}`} class="mt-16 grid scroll-mt-24 gap-6 lg:grid-cols-[18rem_1fr] lg:gap-16">
            <div>
              <h2 class="text-[1.875rem] sm:text-[2.25rem]">{category.title}</h2>
              <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{category.description}</p>
            </div>
            <ul class="grid border-t-2 border-ink sm:grid-cols-2 sm:gap-x-10">
              {category.guides.map((guide) => (
                <li class="border-b border-rule">
                  <a href={withTrailingSlash(guide.path)} class="group block h-full px-1 py-5 transition-colors hover:bg-spot-wash">
                    <h3 class="text-[1.375rem] leading-tight underline decoration-spot decoration-[3px] underline-offset-[5px]">{guide.title}</h3>
                    <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{guide.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Shell>
</Layout>
