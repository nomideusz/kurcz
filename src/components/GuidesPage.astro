---
// Guides hub for every locale: the label band, then each category as a composition table.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import PageHeader from './PageHeader.astro';
import CompositionRow from './CompositionRow.astro';
import { withTrailingSlash, type SupportedLocale } from '../i18n/config.ts';

const { route, lang, currentPath, title, intro, categories } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  title: string;
  intro: string;
  categories: { title: string; description: string; guides: { path: string; title: string; description: string }[] }[];
};
const en = lang === 'en';
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <PageHeader title={title} intro={intro} route={route} currentPath={currentPath} />

    <nav aria-label={en ? 'Guide categories' : 'Kategorie poradników'}>
      <ul class="mx-auto flex max-w-[1240px] flex-wrap gap-2 px-4 pt-12 sm:px-8">
        {
          categories.map((category, idx) => (
            <li>
              <a href={`#kat-${idx}`} class="inline-flex min-h-10 items-center gap-1.5 rounded-full border-2 border-label px-4 text-[0.9375rem] font-bold text-label transition-colors hover:bg-wash">
                {category.title} <span class="font-normal text-muted">({category.guides.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mx-auto max-w-[1240px] px-4 sm:px-8">
      {
        categories.map((category, idx) => (
          <section id={`kat-${idx}`} class="mt-16 grid scroll-mt-24 gap-6 lg:grid-cols-[18rem_1fr] lg:gap-16">
            <div>
              <h2 class="text-[1.75rem] sm:text-[2.125rem]">{category.title}</h2>
              <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{category.description}</p>
            </div>
            <ul class="composition grid self-start sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
              {category.guides.map((guide) => (
                <CompositionRow href={withTrailingSlash(guide.path)} title={guide.title} desc={guide.description} as="h3" />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Shell>
</Layout>
