---
// Guides hub for every locale: the sheet header, then each category as a chart index whose
// rows carry their guide's plate.
import Layout from '../layouts/Layout.astro';
import Shell from './Shell.astro';
import PageHeader from './PageHeader.astro';
import CompositionRow from './CompositionRow.astro';
import { withTrailingSlash, type SupportedLocale } from '../i18n/config.ts';

const { route, lang, currentPath, title, intro, categories } = Astro.props as {
  route: any;
  lang: SupportedLocale;
  currentPath: string;
  title: string;
  intro: string;
  categories: { title: string; description: string; guides: { path: string; title: string; description: string }[] }[];
};
const en = lang === 'en';
---

<Layout route={route} lang={lang}>
  <Shell currentPath={currentPath}>
    <PageHeader title={title} intro={intro} route={route} currentPath={currentPath} />

    <nav aria-label={en ? 'Guide categories' : 'Kategorie poradników'} class="page-x pt-8 lg:pt-[calc(var(--u)*2)]">
      <ul class="flex flex-wrap gap-2">
        {
          categories.map((category, idx) => (
            <li>
              <a href={`#kat-${idx}`} class="inline-flex min-h-11 items-center gap-1.5 rounded-[6px] border-2 border-slate px-4 text-base font-semibold text-slate transition-colors hover:bg-wash">
                {category.title} <span class="font-normal tabular-nums text-muted">({category.guides.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="page-x">
      {
        categories.map((category, idx) => (
          <section id={`kat-${idx}`} class="mt-14 lg:mt-[calc(var(--u)*3.4)]">
            <div class="border-t-2 border-slate/70 pt-4">
              <h2 class="text-[1.75rem] font-bold sm:text-[2.25rem]">{category.title}</h2>
              <p class="mt-2 max-w-[44rem] text-[1.0625rem] leading-relaxed text-muted">{category.description}</p>
            </div>
            <ul class="chart-table mt-5 grid sm:grid-cols-2">
              {category.guides.map((guide) => (
                <CompositionRow href={withTrailingSlash(guide.path)} title={guide.title} desc={guide.description} as="h3" thumb />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Shell>
</Layout>
