---
import { extractLocale, localizeHref, routing, t } from '../i18n/config.ts';

const { route, currentPath = route?.path ?? '/' } = Astro.props;
const { locale } = extractLocale(currentPath, routing);

const homeHref = localizeHref('/', locale, routing);
const homeLabel = t(locale, 'nav.home');

const crumbs = [{ path: homeHref, label: homeLabel }];
if (route.hubPath && route.hubLabel) {
  const hubHref = localizeHref(route.hubPath, locale, routing);
  crumbs.push({ path: hubHref, label: route.hubLabel.toLowerCase() });
}
const current = (route.breadcrumbLabel ?? route.h1).toLowerCase();
---

{
  route.path !== '/' && (
    <nav
      aria-label={locale === 'en' ? 'Breadcrumb navigation' : 'Ścieżka okruszków'}
      class="mx-auto max-w-7xl px-5 pt-10 font-mono text-[12.5px] text-faint sm:px-14"
    >
      {crumbs.map((c) => (
        <>
          <a href={c.path} class="text-faint hover:text-ink">{c.label}</a>
          <span class="mx-1.5 text-[#c3b7a2]">/</span>
        </>
      ))}
      <span class="text-accent" aria-current="page">{current}</span>
    </nav>
  )
}
