---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.svelte';
import AiSearch from './AiSearch.svelte';
import Icon from './Icon.astro';
import { extractLocale, localizeHref, routing, t } from '../i18n/config.ts';

const { currentPath = '/' } = Astro.props;
const { locale, pathname } = extractLocale(currentPath, routing);

const nav = [
  { path: '/kurcze-miesniowe', key: 'nav.causes' },
  { path: '/pierwsza-pomoc', key: 'nav.first_aid', highlight: true },
  { path: '/profilaktyka', key: 'nav.prevention' },
  { path: '/kurcz-vs-skurcz', key: 'nav.comparison' },
  { path: '/poradniki', key: 'nav.guides' },
  { path: '/faq', key: 'nav.faq' },
];


const homeHref = localizeHref('/', locale, routing);
const contactHref = localizeHref('/kontakt', locale, routing);
const firstAidHref = localizeHref('/pierwsza-pomoc', locale, routing);

const isActive = (path) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<header class="sticky top-0 z-40 bg-label text-on-label">
  <div class="mx-auto flex h-16 max-w-[1240px] items-center justify-between gap-4 px-4 sm:px-8">
    <a href={homeHref} class="flex items-center" aria-label={locale === 'en' ? 'Kurcz.pl — home' : 'Kurcz.pl — strona główna'}>
      <Logo class="text-[1.75rem]" />
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label={locale === 'en' ? 'Main navigation' : 'Główna nawigacja'}>
      {
        nav.map((item) => {
          const href = localizeHref(item.path, locale, routing);
          const active = isActive(item.path);
          return (
            <a
              href={href}
              class:list={[
                'relative whitespace-nowrap rounded-full px-2.5 py-2 text-[0.9375rem] leading-none text-on-label transition-colors hover:bg-label-deep lg:px-3',
                active && 'font-bold after:absolute after:inset-x-2.5 after:-bottom-[13px] after:h-[3px] after:rounded-full after:bg-on-label lg:after:inset-x-3',
                item.highlight && !active && 'font-bold',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {t(locale, item.key)}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <AiSearch client:idle locale={locale} />
      <LanguageSwitcher client:load currentPath={currentPath} currentLocale={locale} />
      <a href={contactHref} class="hidden rounded-full px-2.5 py-2 text-[0.9375rem] leading-none text-on-label hover:bg-label-deep xl:inline-flex">
        {t(locale, 'nav.contact')}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-on-label/60 text-on-label transition-colors hover:bg-label-deep lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-on-label/20 bg-label-deep px-4 pb-6 pt-4 lg:hidden"
    aria-label={locale === 'en' ? 'Mobile navigation' : 'Nawigacja mobilna'}
  >
    <a href={firstAidHref} class="mb-4 flex items-center justify-between gap-3 rounded-[var(--radius-label)] bg-on-label px-4 py-3.5 text-base font-bold text-label-deep">
      <span class="inline-flex items-center gap-2.5">
        <Icon name="first-aid" class="h-5 w-5" />
        <span>{t(locale, 'nav.first_aid')} — {locale === 'en' ? 'quick relief' : 'szybka ulga'}</span>
      </span>
      <Icon name="arrow" class="h-5 w-5 flex-none" />
    </a>
    <div class="flex flex-col">
      {
        [
          { path: '/', key: 'nav.home' },
          { path: '/kurcze-miesniowe', key: 'nav.causes' },
          { path: '/profilaktyka', key: 'nav.prevention' },
          { path: '/kurcz-vs-skurcz', key: 'nav.comparison' },
          { path: '/poradniki', key: 'nav.guides' },
          { path: '/faq', key: 'nav.faq' },
          { path: '/kontakt', key: 'nav.contact' },
        ].map((item) => {
          const active = isActive(item.path);
          return (
            <a
              href={localizeHref(item.path, locale, routing)}
              class:list={['flex items-center justify-between border-b border-on-label/20 py-3.5 text-lg text-on-label last:border-b-0', active && 'font-bold']}
              aria-current={active ? 'page' : undefined}
            >
              <span>{t(locale, item.key)}</span>
              {active && <span class="h-2.5 w-2.5 rounded-full bg-on-label" aria-hidden="true" />}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
      }
    });
  })();
</script>

