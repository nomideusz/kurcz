---
// The cloth binding: a full-height slate rail on desktop (wordmark, nav, search, language,
// quick relief); on a phone it folds to a bar whose menu button opens the same rail.
import Logo from './Logo.astro';
import AiSearch from './AiSearch.svelte';
import ReliefSteps from './ReliefSteps.astro';
import { extractLocale, localizeHref, routing, t, LOCALES } from '../i18n/config.ts';

const { currentPath = '/' } = Astro.props;
const { locale, pathname } = extractLocale(currentPath, routing);
const en = locale === 'en';

const nav = [
  { path: '/kurcze-miesniowe', key: 'nav.causes' },
  { path: '/pierwsza-pomoc', key: 'nav.first_aid' },
  { path: '/profilaktyka', key: 'nav.prevention' },
  { path: '/kurcz-vs-skurcz', key: 'nav.comparison' },
  { path: '/poradniki', key: 'nav.guides' },
  { path: '/faq', key: 'nav.faq' },
];

const isActive = (path: string) => pathname.startsWith(path);
---

<header
  id="rail"
  class="rail sticky top-0 z-40 text-on-slate max-lg:max-h-dvh max-lg:overflow-y-auto lg:h-dvh lg:overflow-y-auto">
  <div class="flex flex-wrap items-center gap-x-2.5 px-4 py-2.5 sm:px-6 lg:flex-col lg:flex-nowrap lg:items-stretch lg:py-0 lg:pl-[calc(var(--u)*4.04)] lg:pr-[calc(var(--u)*1.8)] lg:pt-[calc(var(--u)*2.2)]">
    <a href={localizeHref('/', locale, routing)} class="order-1 mr-auto rounded-[3px] lg:order-none lg:mr-0 lg:self-start" aria-label={en ? 'Kurcz.pl — home' : 'Kurcz.pl — strona główna'}>
      <Logo class="text-[2rem] lg:text-[max(2.75rem,calc(var(--u)*4.49))]" />
    </a>

    <hr class="hidden border-t-2 border-on-slate/60 lg:mt-[calc(var(--u)*1.83)] lg:mb-[calc(var(--u)*0.57)] lg:block" />

    <nav class="rail-drawer order-4 w-full lg:order-none" aria-label={en ? 'Main navigation' : 'Główna nawigacja'}>
      <ul class="flex flex-col py-2 lg:py-0">
        {
          nav.map((item) => {
            const active = isActive(item.path);
            return (
              <li>
                <a
                  href={localizeHref(item.path, locale, routing)}
                  class:list={[
                    'rail-link block py-2.5 text-[1.25rem] leading-tight lg:py-[calc(var(--u)*0.62)] lg:text-[max(1.125rem,calc(var(--u)*1.82))]',
                    active ? 'font-bold' : 'font-medium',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(locale, item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="order-2 lg:order-none lg:mt-[calc(var(--u)*1.3)]">
      <AiSearch client:idle locale={locale} />
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="order-3 inline-flex h-11 w-11 items-center justify-center rounded-[3px] border-[1.5px] border-on-slate/75 text-on-slate transition-colors hover:bg-slate-deep lg:hidden"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="rail"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path class="menu-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        <path class="menu-close" stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="rail-drawer order-5 flex w-full items-center gap-[calc(var(--u)*4.4)] border-t border-on-slate/25 py-3 text-[1.125rem] lg:order-none lg:mt-[calc(var(--u)*1.7)] lg:border-t-0 lg:py-0 lg:text-[max(1.0625rem,calc(var(--u)*1.47))]">
      {
        LOCALES.filter((loc) => loc !== locale).map((loc) => (
          <a href={localizeHref(pathname, loc, routing)} hreflang={loc} lang={loc} class="rail-link" aria-label={loc === 'en' ? 'English version' : 'Wersja polska'}>
            {loc.toUpperCase()}
          </a>
        ))
      }
      <a href={localizeHref('/kontakt', locale, routing)} class="rail-link" aria-current={isActive('/kontakt') ? 'page' : undefined}>{t(locale, 'nav.contact')}</a>
    </div>
  </div>

  <section
    class="rail-drawer order-6 border-t-2 border-on-slate/70 px-4 pb-6 pt-5 sm:px-6 lg:mt-[calc(var(--u)*1.6)] lg:pb-[calc(var(--u)*2)] lg:pl-[calc(var(--u)*4.04)] lg:pr-[calc(var(--u)*1.8)] lg:pt-[calc(var(--u)*1.75)]"
    aria-labelledby="relief-title"
  >
    <p id="relief-title" class="font-head text-[1.375rem] font-bold leading-tight lg:text-[max(1.25rem,calc(var(--u)*1.92))]">
      <a href={localizeHref('/pierwsza-pomoc', locale, routing)} class="rail-link">{t(locale, 'relief.title')}</a>
    </p>
    <ReliefSteps locale={locale} class="mt-2 lg:mt-[calc(var(--u)*0.7)]" />
  </section>
</header>

<script is:inline>
  (function () {
    var rail = document.getElementById('rail');
    var btn = document.getElementById('menu-toggle');
    if (!rail || !btn) return;
    btn.addEventListener('click', function () {
      var open = !rail.hasAttribute('data-open');
      rail.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
