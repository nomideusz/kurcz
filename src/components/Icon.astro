---
interface Props {
  name:
    | 'calf'
    | 'night'
    | 'pregnancy'
    | 'foot'
    | 'magnesium'
    | 'sport'
    | 'hand'
    | 'senior'
    | 'first-aid'
    | 'warning'
    | 'clock'
    | 'calendar'
    | 'verified'
    | 'medical'
    | 'toc'
    | 'faq'
    | 'document';
  class?: string;
  size?: number | string;
}

const { name, class: className = 'w-5 h-5', size } = Astro.props;
const dimension = size ? { width: size, height: size } : {};
