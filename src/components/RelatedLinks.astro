---
import CompositionRow from './CompositionRow.astro';
import {
  extractLocale,
  routing,
  t,
  withTrailingSlash,
  type SupportedLocale,
} from '../i18n/config.ts';

const { links = [], heading, currentPath = Astro.url.pathname, lang } = Astro.props as {
  links?: any[];
  heading?: string;
  currentPath?: string;
  lang?: SupportedLocale;
};

const { locale } = extractLocale(currentPath, routing);
const effectiveLang = lang ?? locale;
const title = heading ?? t(effectiveLang, 'related_links.heading');
---

{
  links.length > 0 && (
    <nav aria-label={title} class="page-x mt-20">
      <h2 class="border-t-2 border-slate/70 pt-4 text-[1.75rem] sm:text-[2.125rem]">{title}</h2>
      <ul class="chart-table mt-5 grid sm:grid-cols-2">
        {links.map((l) => (
          <CompositionRow href={l.path.startsWith('http') ? l.path : withTrailingSlash(l.path)} title={l.label} external={l.path.startsWith('http')} thumb />
        ))}
      </ul>
    </nav>
  )
}
