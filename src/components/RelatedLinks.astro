---
import { extractLocale, routing, t, type SupportedLocale } from '../i18n/config.ts';

const { links = [], heading, currentPath = Astro.url.pathname, lang } = Astro.props as {
  links?: any[];
  heading?: string;
  currentPath?: string;
  lang?: SupportedLocale;
};

const { locale } = extractLocale(currentPath, routing);
const effectiveLang = lang ?? locale;
const title = heading ?? t(effectiveLang, 'related_links.heading');
---

{
  links.length > 0 && (
    <nav aria-label={title} class="mx-auto max-w-7xl px-5 pb-12 sm:px-14">
      <div class="eyebrow mb-4">{title}</div>
      <ul class="flex flex-wrap gap-2.5">
        {links.map((l) => (
          <li>
            <a
              href={l.path}
              class="inline-flex rounded-full border border-line bg-card px-4 py-2 text-sm font-medium text-body transition-colors hover:border-accent-border hover:text-accent"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
