---
import CompositionRow from './CompositionRow.astro';
import {
  extractLocale,
  routing,
  t,
  withTrailingSlash,
  type SupportedLocale,
} from '../i18n/config.ts';

const { links = [], heading, currentPath = Astro.url.pathname, lang } = Astro.props as {
  links?: any[];
  heading?: string;
  currentPath?: string;
  lang?: SupportedLocale;
};

const { locale } = extractLocale(currentPath, routing);
const effectiveLang = lang ?? locale;
const title = heading ?? t(effectiveLang, 'related_links.heading');
---

{
  links.length > 0 && (
    <nav aria-label={title} class="mx-auto mt-20 grid max-w-[1240px] gap-6 px-4 sm:px-8 lg:grid-cols-[16rem_1fr] lg:gap-16">
      <h2 class="text-[1.75rem] sm:text-[2rem]">{title}</h2>
      <ul class="composition grid max-w-[48rem] sm:grid-cols-2">
        {links.map((l) => (
          <CompositionRow href={l.path.startsWith('http') ? l.path : withTrailingSlash(l.path)} title={l.label} external={l.path.startsWith('http')} />
        ))}
      </ul>
    </nav>
  )
}
