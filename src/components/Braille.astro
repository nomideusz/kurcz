---
// Embossed Braille, as printed on a medicine box. Decorative: the word is also set in type.
const { word = 'kurcz', class: className = 'h-5' } = Astro.props;

// Raised dots per letter (1–3 left column top→bottom, 4–6 right column).
const DOTS: Record<string, number[]> = {
  k: [1, 3], u: [1, 3, 6], r: [1, 2, 3, 5], c: [1, 4], z: [1, 3, 5, 6],
};
const pos = (d: number) => ({ x: d <= 3 ? 0 : 1, y: (d - 1) % 3 });
const cells = [...word].map((ch) => DOTS[ch] ?? []);
const W = cells.length * 4 - 1.5;
---

<svg class={className} viewBox={`-0.9 -0.9 ${W + 1.8} 6.8`} fill="currentColor" aria-hidden="true">
  {cells.map((dots, i) => dots.map((d) => <circle cx={i * 4 + pos(d).x * 2.5} cy={pos(d).y * 2.5} r="0.9" />))}
</svg>
