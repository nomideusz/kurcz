---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_URL, getOgImage } from '../seo/routes.js';
import { buildPageSchema, schemaToJsonLd } from '../seo/schema.js';
import { extractLocale, alternates, routing, DEFAULT_LOCALE, localizeHref, toLogicalPath } from '../i18n/config.ts';

const {
  route,
  lang,
  robots = 'index, follow',
  includeCanonical = true,
} = Astro.props;

const currentPath = route.path ?? Astro.url.pathname;
const { locale, pathname } = extractLocale(currentPath, routing);
const effectiveLang = lang ?? locale ?? DEFAULT_LOCALE;
const logicalPath = toLogicalPath(pathname === '/' ? '/' : route.path ?? pathname);

function withTrailingSlash(href) {
  const url = new URL(href);
  if (url.pathname !== '/' && !url.pathname.endsWith('/')) {
    url.pathname += '/';
  }
  return url.href;
}

const localizedPath = localizeHref(logicalPath, effectiveLang, routing);
const canonical = withTrailingSlash(`${SITE_URL}${localizedPath === '/' ? '/' : localizedPath}`);
const ogTitle = route.ogTitle ?? route.title;
const ogImage = getOgImage(route);
const ogType = route.path === '/' ? 'website' : 'article';
const jsonLd = includeCanonical
  ? schemaToJsonLd(
      buildPageSchema(route, {
        locale: effectiveLang,
        canonicalUrl: canonical,
      }),
    )
  : '';

const alternateLinks = alternates(logicalPath, routing, SITE_URL).map((link) => ({
  ...link,
  href: withTrailingSlash(link.href),
}));
const ogLocaleMap = { pl: 'pl_PL', en: 'en_US' };
const ogLocale = ogLocaleMap[effectiveLang] ?? 'pl_PL';
const alternateOgLocale = effectiveLang === 'en' ? 'pl_PL' : 'en_US';
---

<!doctype html>
<html lang={effectiveLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Alternate language links for SEO -->
    {
      includeCanonical &&
        alternateLinks.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))
    }

    <!-- Google Consent Mode v2 (default: denied until user accepts) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      try {
        if (localStorage.getItem('kurcz_cookie_consent') === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) {}
    </script>

    <!-- Rybbit analytics (cookieless, no consent needed) -->
    <script
      is:inline
      defer
      src="https://rybit.picarro.info/api/script.js"
      data-site-id="3"></script>
    <!-- Subsetted, self-hosted Source Serif 4. No preload: the metric-matched fallback paints
         the H1 shift-free, so preloading would only steal critical bandwidth at first paint. -->
    <Font cssVariable="--font-serif-src" />

    <!-- Google Tag Manager (Deferred to First User Interaction or Idle fallback) -->
    <script is:inline>
      (function () {
        var gtmLoaded = false;
        function loadGtm() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', 'GTM-P7N9JKMT');
        }

        // Trigger loading on first user interaction
        var events = ['click', 'mousedown', 'mousemove', 'keydown', 'touchstart', 'scroll'];
        events.forEach(function (e) {
          window.addEventListener(e, loadGtm, { passive: true, once: true });
        });
      })();
    </script>
    <!-- End Google Tag Manager -->

    <title>{route.title}</title>
    <meta name="description" content={route.description} />
    {includeCanonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={route.description} />
    {includeCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:site_name" content="Kurcz.pl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={route.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons / manifest -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#f4efe6" />

    <!-- Structured data -->
    {includeCanonical && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P7N9JKMT"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <slot />
  </body>
</html>
